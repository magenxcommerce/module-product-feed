<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magenx_product_feed_listing.magenx_product_feed_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>magenx_product_feed_columns</spinner>
        <deps>
            <dep>magenx_product_feed_listing.magenx_product_feed_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Feed</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="magenx_product_feed_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">feed_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magenx_ProductFeed::feed</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="magenx_product_feed_listing_data_source">
            <settings>
                <requestFieldName>feed_id</requestFieldName>
                <primaryFieldName>feed_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="magenx_product_feed_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">magenx_product_feed_listing.magenx_product_feed_listing.magenx_product_feed_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <column name="feed_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>

        <column name="code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Code</label>
            </settings>
        </column>

        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store" sortOrder="40">
            <settings>
                <label translate="true">Store View</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>

        <column name="format" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Magenx\ProductFeed\Model\Config\Source\Format"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Format</label>
            </settings>
        </column>

        <column name="status" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="product_count" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Products</label>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>

        <column name="last_generated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Generated</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="Magenx\ProductFeed\Ui\Component\Listing\Column\FeedActions" sortOrder="100">
            <settings>
                <indexField>feed_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
